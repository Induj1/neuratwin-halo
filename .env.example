# Copy to .env; start-halo.ps1 and the opt-in bridge/worker load it.
# Tests deliberately do not load .env. Never put secrets in JS or NFC tags.
HALO_AI_ENABLED=1
HALO_ALLOW_CONTROL=0
HALO_STORAGE_BACKEND=sqlite
# For Supabase, apply supabase/migrations in order, then select supabase above.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<project publishable key>
# SUPABASE_SECRET_KEY=<server-only secret key>
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Development only: 1 grants this loopback computer a local owner session.
# Leave 0 on a shared or publicly hosted server. Team login uses Supabase Auth.
HALO_LOCAL_OPERATOR=0
# Shared device secret. The Wi-Fi board (firmware/esp32_integration) checks it as
# API_TOKEN; the USB bridge sends it too. Generate locally, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# HALO_DEVICE_TOKEN=<generate a strong shared secret locally>
# Wi-Fi ESP32 integration: base URL of the board (mDNS name or IP from the serial
# monitor). Unset = integration off. Load switching also needs HALO_ALLOW_CONTROL=1.
# HALO_ESP32_URL=http://halo-esp32.local
# HALO_ESP32_POLL_SECONDS=2
# HALO_OPERATOR_TOKEN=<optional server administrator credential; not a Supabase key>
# HALO_PUBLIC_URL=https://your-reachable-full-app-host.example
# HALO_TELEGRAM_BOT_TOKEN=<from BotFather>
# HALO_TELEGRAM_ALLOWED_CHAT_IDS=<explicit comma-separated chat IDs>
# NEURATWIN_DB=<optional absolute database path>
